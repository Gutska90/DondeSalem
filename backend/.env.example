# Copiar a .env y exportar, o usar con tu IDE / systemd
DATABASE_URL=jdbc:postgresql://localhost:5432/dondesalem
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
JWT_SECRET=cambiar-por-cadena-larga-minimo-32-caracteres
JWT_EXPIRATION_MS=86400000
PORT=8080
CORS_ORIGINS=http://localhost:3000

# URL del front para enlaces absolutos (checkout demo Mercado Pago → /checkout/pago-simulado)
PUBLIC_FRONTEND_URL=http://localhost:3000

# Solo para crear el primer usuario ADMIN vía POST /api/auth/bootstrap-admin (dejar vacío para desactivar)
# ADMIN_BOOTSTRAP_TOKEN=un-secreto-largo

# Datos de cuenta para transferencia (multilínea). Aparecen en el checkout (GET /api/config/public) y en el mail si SMTP está configurado.
# TRANSFER_BANK_INSTRUCTIONS="Banco Estado · Cuenta vista\nTitular: ...\nRUT: ...\nCorreo: pagos@..."

# Caducidad del enlace de recuperación de contraseña (minutos)
# PASSWORD_RESET_EXPIRATION_MIN=60

# Opcional: correo al confirmar pedido (requiere spring.mail.* vía application.yml o variables)
# MAIL_FROM=noreply@tudominio.cl
# RATE_LIMIT_AUTH_PER_MIN=30
# RATE_LIMIT_CONTACT_PER_MIN=15
