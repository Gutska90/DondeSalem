# Copiar a backend/.env y ajustar (no se commitea).
# cp .env.example .env

# --- Con Docker Compose (recomendado en desarrollo) ---
# Postgres en localhost:5433 — ver docker-compose.yml y application-local.yml
DATABASE_URL=jdbc:postgresql://localhost:5433/dondesalem
DATABASE_USER=dondesalem
DATABASE_PASSWORD=dondesalem_dev

# --- Supabase (producción): usar pooler + sslmode=require en Railway ---
# DATABASE_URL=jdbc:postgresql://HOST.pooler.supabase.com:5432/postgres?sslmode=require
# DATABASE_USER=postgres.PROJECT_REF
# DATABASE_PASSWORD=tu_password_de_supabase
# Si la contraseña tiene $ o #, en Railway Raw Editor usa comillas: DATABASE_PASSWORD="..."
# No fijes PORT=8080 en Railway; el panel asigna PORT automáticamente.

# --- Sin Docker (Postgres nativo en 5432) ---
# DATABASE_URL=jdbc:postgresql://localhost:5432/dondesalem
# DATABASE_USER=tu_usuario
# DATABASE_PASSWORD=tu_password

JWT_SECRET=cambiar-por-cadena-larga-minimo-32-caracteres
JWT_EXPIRATION_MS=86400000
PORT=8080
CORS_ORIGINS=http://localhost:3000
PUBLIC_FRONTEND_URL=http://localhost:3000

# Arranque recomendado con Docker:
#   mvn spring-boot:run -Dspring-boot.run.profiles=local

# Solo para crear el primer usuario ADMIN vía POST /api/auth/bootstrap-admin
# ADMIN_BOOTSTRAP_TOKEN=

# Transferencia (checkout / mail)
# TRANSFER_BANK_INSTRUCTIONS="Banco Estado · Cuenta vista\nTitular: ..."

# Google OAuth — mismo Client ID que GOOGLE_CLIENT_ID en frontend/.env.local
# Orígenes autorizados en Google Cloud: http://localhost:3000
# Redirect URI (NextAuth): http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_IDS=

# false = solo Google para clientes (por defecto)
PASSWORD_LOGIN_ENABLED=false

# TOTP_ISSUER=DondeSalem
# TOTP_PENDING_JWT_MS=300000
# PASSWORD_RESET_EXPIRATION_MIN=60
# MAIL_FROM=
# RATE_LIMIT_AUTH_PER_MIN=30
# RATE_LIMIT_CONTACT_PER_MIN=15
