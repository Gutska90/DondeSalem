# Copiar a .env en la raíz del repo (docker compose lo lee para Postgres).
# cp .env.example .env

# --- PostgreSQL (servicio db en docker-compose.yml) ---
POSTGRES_PORT=5433
POSTGRES_USER=dondesalem
POSTGRES_PASSWORD=dondesalem_dev
POSTGRES_DB=dondesalem

